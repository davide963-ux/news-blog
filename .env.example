# ───────────── Database (PostgreSQL: Neon / Vercel Postgres / Supabase / any) ─────────────
# Pooled connection string used at runtime (serverless-friendly, e.g. Neon "-pooler" host, add ?pgbouncer=true&connection_limit=1 if using PgBouncer)
DATABASE_URL="postgresql://user:password@host:5432/newsblog?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate deploy`
DIRECT_URL="postgresql://user:password@host:5432/newsblog?sslmode=require"

# ───────────── Security (generate each with: openssl rand -base64 48) ─────────────
SESSION_SECRET=""        # signs admin session cookies (>= 32 chars). REQUIRED in production.
APP_ENCRYPTION_KEY=""    # encrypts stored secrets (API keys / source headers). REQUIRED in production. Do not rotate casually: stored secrets become unreadable.
CRON_SECRET=""           # Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>" to cron routes
SETUP_TOKEN=""           # one-time token to create the first administrator at /admin/login (remove after setup)

# ───────────── Site ─────────────
NEXT_PUBLIC_SITE_URL="https://your-domain.com"   # canonical URL used in sitemaps, JSON-LD, Open Graph
BOT_CONTACT_EMAIL="webmaster@your-domain.com"    # included in the crawler User-Agent so publishers can contact you

# ───────────── AI (set the one you use; can also be entered in Admin → Settings → AI) ─────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""        # also used for optional embeddings and AI illustrations
# AI_API_KEY=""          # generic key for an OpenAI-compatible provider

# ───────────── Images (all optional) ─────────────
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""
BLOB_READ_WRITE_TOKEN="" # Vercel Blob (auto-injected when a Blob store is connected). Without it images are stored in PostgreSQL.

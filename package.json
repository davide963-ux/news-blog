{
  "name": "news-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Automated AI-assisted news platform (Next.js, Prisma, PostgreSQL) designed for Vercel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/with-db-env.mjs prisma generate && next build",
    "vercel-build": "node scripts/with-db-env.mjs prisma generate && node scripts/with-db-env.mjs prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e-pipeline.ts",
    "db:migrate": "node scripts/with-db-env.mjs prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "tick": "tsx scripts/run-tick.ts",
    "postinstall": "node scripts/with-db-env.mjs prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^1.1.1",
    "bcryptjs": "2.4.3",
    "cheerio": "1.0.0",
    "fast-xml-parser": "^4.5.1",
    "jose": "5.10.0",
    "marked": "^15.0.7",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "robots-parser": "3.0.1",
    "sanitize-html": "2.17.0",
    "sharp": "^0.34.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.16",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/sanitize-html": "2.16.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
